# SC2120: Function references arguments, but none are ever passed.
# SC2317: Command appears to be unreachable.
# SC2329: This function is never invoked.
# shellcheck disable=SC2120,SC2317,SC2329
set -Ceuo pipefail

PLUGIN_ID=$(uv version --output-format=json | jq -er '.package_name | sub("-"; "_")')

PLUGINDIR="./$PLUGIN_ID"

# Requires:
# - QGIS 3 or 4 for the PyQGIS API
# - qt6-qtbase-devel for rcc
# - qt6-linguist for lupdate-pro and lrelease-pro
# - python3-pyqt6-base for pyuic6

QGIS_PYTHON=/usr/bin/python3
QGIS_PROFILE=default

PATH+=":/usr/lib64/qt6/bin"
PATH+=":/usr/lib64/qt6/libexec"
#PATH+=":/usr/lib64/qt5/bin"

##############
# Main Tasks #
##############

setup-venv() {
	uv venv --python="$QGIS_PYTHON" --system-site-packages
	# uv pip install --editable ..
	uv sync
}

translate() {
	lupdate
}

build() {
	build-metadata
	build-translations
	build-forms-and-resources
	build-help
}

deploy() {
	local plugindir datadir qgis3profile qgis4profile
	plugindir=$(realpath -- "$PLUGINDIR")
	datadir=$(application-data-directory)

	qgis3profile="$datadir/QGIS/QGIS3/profiles/$QGIS_PROFILE"
	if [[ -d "$qgis3profile" ]]; then
		mkdir -p -- "$qgis3profile/python/plugins"
		ln -sfvT -- "$plugindir" "$qgis3profile/python/plugins/$PLUGIN_ID"
	fi

	qgis4profile="$datadir/QGIS/QGIS4/profiles/$QGIS_PROFILE"
	if [[ -d "$qgis4profile" ]]; then
		mkdir -p -- "$qgis4profile/python/plugins"
		ln -sfvT -- "$plugindir" "$qgis4profile/python/plugins/$PLUGIN_ID"
	fi
}

undeploy() {
	local datadir
	datadir=$(application-data-directory)
	rm -fv -- "$datadir/QGIS/QGIS3/profiles/$QGIS_PROFILE/python/plugins/$PLUGIN_ID"
	rm -fv -- "$datadir/QGIS/QGIS4/profiles/$QGIS_PROFILE/python/plugins/$PLUGIN_ID"
}

package() {
	build

	build-zip
}

clean() {
	rm -f -- \
		"$PLUGINDIR/LICENSE"      \
		"$PLUGINDIR/metadata.txt" \
		"$PLUGINDIR/help"         \
		"$PLUGINDIR/i18n"/*.qm    \
		"$PLUGINDIR/ui"/*.py      \
		# EOA
	sphinx-make clean
}

###############
# Build Tasks #
###############

build-metadata() {
	ln -fT -- LICENSE  "$PLUGINDIR/LICENSE"
	plugin-metadata >| "$PLUGINDIR/metadata.txt"
}

build-translations() {
	lrelease
}

build-forms-and-resources() {
	pyuic6 -- "$PLUGINDIR/ui"
	sed -i 's/^from PyQt6/from qgis.PyQt/' -- "$PLUGINDIR/ui"/*.py
}

build-help() {
	sphinx-make html
	ln -fT -- docs/LICENSE docs/_build/html/LICENSE
	ln -sfrT -- docs/_build/html "$PLUGINDIR/help"
}

build-zip() {
	local zipname zipfile
	#zipfile="dist/${PLUGIN_ID//_/-}-$PLUGIN_VERSION.zip"
	zipname=$(uv version --output-format=json | jq -er '"\(.package_name)-\(.version)"')
	zipfile="dist/$zipname.zip"

	# These must currently be equal for the ZIP file to include the correct
	# plugin path. You can work around this with symlinks, if necessary.
	[[ "$PLUGINDIR" == "./$PLUGIN_ID" ]]

	rm -f "$zipfile"
	zip -r -MM "$zipfile" "$PLUGIN_ID" -x '*/__pycache__/*' '*/.buildinfo*' \
		'*/.git*' '*.pyc' '*.ts' '*.ui'
}

#######################
# Supplementary Tasks #
#######################

lupdate() {
	lupdate-pro -tr-function-alias='tr+=__tr' casageotools_qgis.pro "$@"
}

lrelease() {
	lrelease-pro casageotools_qgis.pro "$@"
}

sphinx-make() {
	make -C docs SPHINXBUILD='uv run sphinx-build' "$@"
}

