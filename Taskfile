application-data-directory() {
	: 'Return the system-specific data directory for GUI applications.'
	case "$OSTYPE" in
	linux-gnu*)     printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}" ;;
	darwin*)        printf '%s\n' "$HOME/Library/Application Support"    ;;
	cygwin*|msys*)  printf '%s\n' "$APPDATA"                             ;;
	*)              return 1                                             ;;
	esac
}

plugin-metadata() {
	# This file contains plugin metadata. It should be included when packaging.
	# See https://docs.qgis.org/3.44/en/docs/pyqgis_developer_cookbook/plugins/plugins.html#metadata-txt
	yq --version >/dev/null
	cat <<-METADATA
	[general]
	name = $(yq -r '.tool.qgis.metadata.general.name // ""' pyproject.toml)
	version = $(yq -r '.project.version // ""' pyproject.toml)
	author = $(yq -r '.project.authors[0].name // ""' pyproject.toml)
	email = $(yq -r '.project.authors[0].email // ""' pyproject.toml)
	description = $(yq -r '.project.description // ""' pyproject.toml)
	qgisMinimumVersion = $(yq -r '.tool.qgis.metadata.general.qgisMinimumVersion // ""' pyproject.toml)
	qgisMaximumVersion = $(yq -r '.tool.qgis.metadata.general.qgisMaximumVersion // ""' pyproject.toml)
	experimental = $(yq -r '.tool.qgis.metadata.general.experimental // false' pyproject.toml)
	deprecated = $(yq -r '.tool.qgis.metadata.general.deprecated // false' pyproject.toml)
	tags = $(yq -r '.tool.qgis.metadata.general.tags // [] | join(",")' pyproject.toml)
	homepage = $(yq -r '.project.urls.Homepage // ""' pyproject.toml)
	repository = $(yq -r '.project.urls.Source // ""' pyproject.toml)
	tracker = $(yq -r '.project.urls.Issues // ""' pyproject.toml)
	icon = $(yq -r '.tool.qgis.metadata.general.icon // ""' pyproject.toml)
	category = $(yq -r '.tool.qgis.metadata.general.category // ""' pyproject.toml)
	plugin_dependencies = $(yq -r '.tool.qgis.metadata.general.plugin_dependencies // [] | join(",")' pyproject.toml)
	server = $(yq -r '.tool.qgis.metadata.general.server // false' pyproject.toml)
	hasProcessingProvider = $(yq -r '.tool.qgis.metadata.general.hasProcessingProvider // false' pyproject.toml)
	METADATA
	sed -e '1c about ='     -e '/^\s*<!--.*-->\s*$/d' -e '/./,$!d' -e 's/^/\t/' README.md
	sed -e '1c changelog =' -e '/^\s*<!--.*-->\s*$/d' -e '/./,$!d' -e 's/^/\t/' CHANGELOG.md
}

while [[ ${1-} == +([[:word:]])=* ]]; do declare -- "$1"; shift; done
time { set -x; "$@"; }; exit;
